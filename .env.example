# Copy this file to .env and fill only the values for services you use.
# Do not commit .env.

# Twitch Helix API (create an app at https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# YouTube Data API v3 (enable it in Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_data_api_key

# Optional multimodal reaction explanations. Leave the model placeholder until
# you choose an enabled Gemini model for your account.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_gemini_model_name
