# Settings for the optional Python command-line tool (stream-moments).
# The web app doesn't use this file: its keys live in the Profile tab.
# Copy this file to .env and fill in only what you use. Never commit .env.

# Twitch API (create an app at https://dev.twitch.tv/console/apps)
# Used by: stream-moments fetch-clips, stream-moments metadata
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# YouTube Data API v3 (enable it in Google Cloud Console)
# Used by: stream-moments metadata --platform youtube
YOUTUBE_API_KEY=your_youtube_data_api_key

# Gemini (free key at https://aistudio.google.com/apikey)
# Used by: stream-moments analyze --video ... --gemini-explanations
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_gemini_model_name
